   1. Configuration-First Design (Control Center)

   File: config/cache-strategy.config.ts

   typescript
     export interface CacheStrategyConfig {
       // Role-based profiles
       profiles: {
         client: ClientCacheProfile;
         studio: StudioCacheProfile;
       };

       // Cache TTLs
       ttl: {
         memory: number;        // milliseconds
         indexedDB: number;     // milliseconds
         serviceWorker: number; // milliseconds
       };

       // Storage quotas
       quotas: {
         client: StorageQuota;
         studio: StorageQuota;
       };

       // Eviction thresholds
       eviction: {
         studio: EvictionConfig;
       };

       // Feature flags
       features: {
         memoryCache: boolean;
         indexedDBCache: boolean;
         serviceWorkerCache: boolean;
         prefetching: boolean;
         roleBasedStrategy: boolean;
       };

       // API configuration
       api: {
         endpoints: {
           projectsList: string;    // ?mode=list
           projectsFull: string;    // ?mode=full
           photosMetadata: string;  // ?metadata_only=true
         };
         compression: 'brotli' | 'gzip' | 'none';
       };

       // Logging and monitoring
       monitoring: {
         enableLogging: boolean;
         logLevel: 'debug' | 'info' | 'warn' | 'error';
         enableMetrics: boolean;
         metricsInterval: number; // milliseconds
       };
     }

     interface ClientCacheProfile {
       maxProjects: number;          // unlimited (-1)
       maxMemoryMB: number;          // ~300MB
       maxIndexedDBMB: number;       // ~100MB
       maxServiceWorkerMB: number;   // ~200MB
       prefetchStrategy: 'aggressive' | 'conservative' | 'off';
       prefetchCount: number;        // number of recent projects
     }

     interface StudioCacheProfile {
       maxActiveProjects: number;    // 10 in memory
       maxMemoryMB: number;          // ~500MB
       maxIndexedDBMB: number;       // ~100MB
       maxServiceWorkerMB: number;   // ~1GB
       prefetchStrategy: 'aggressive' | 'conservative' | 'off';
       virtualScrolling: boolean;
     }

     interface StorageQuota {
       greenThresholdMB: number;   // normal operation
       yellowThresholdMB: number;  // soft cleanup
       redThresholdMB: number;     // aggressive eviction
     }

     interface EvictionConfig {
       idleTimeoutMinutes: number;  // 30 min
       lruSlots: number;            // 10
       scoringWeights: {
         lastAccess: number;        // 40%
         frequency: number;         // 30%
         size: number;              // 20%
         pinned: number;            // 10%
       };
     }

