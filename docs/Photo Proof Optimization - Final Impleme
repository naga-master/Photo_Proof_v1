   2. Observable Architecture (Everything Logs)

   File: src/services/cache-events/CacheEventEmitter.ts

   typescript
     export enum CacheEventType {
       // Cache operations
       CACHE_HIT = 'cache.hit',
       CACHE_MISS = 'cache.miss',
       CACHE_SET = 'cache.set',
       CACHE_EVICT = 'cache.evict',
       CACHE_CLEAR = 'cache.clear',

       // Storage operations
       STORAGE_QUOTA_CHECK = 'storage.quota',
       STORAGE_CLEANUP = 'storage.cleanup',

       // API operations
       API_CALL_START = 'api.call.start',
       API_CALL_SUCCESS = 'api.call.success',
       API_CALL_ERROR = 'api.call.error',

       // Prefetch operations
       PREFETCH_START = 'prefetch.start',
       PREFETCH_COMPLETE = 'prefetch.complete',
       PREFETCH_CANCEL = 'prefetch.cancel',

       // Role detection
       ROLE_DETECTED = 'role.detected',
       PROFILE_LOADED = 'profile.loaded',
     }

     export interface CacheEvent {
       type: CacheEventType;
       timestamp: number;
       operationId: string;
       metadata: Record<string, any>;
       context?: {
         userId?: string;
         sessionId?: string;
         role?: 'client' | 'studio';
       };
     }

     export class CacheEventEmitter extends EventEmitter {
       private devModeLogger: DevModeLogger;
       private analyticsHook: AnalyticsHook;

       emit(event: CacheEvent): void;
       subscribe(eventType: CacheEventType, handler: (event: CacheEvent) => void): void;
       getEventHistory(filters?: EventFilters): CacheEvent[];
     }

   Integration Points:
   •  Every cache operation emits events BEFORE and AFTER
   •  Dev mode: Console logger with color-coded output
   •  Production: Analytics hook (e.g., Sentry, DataDog, custom)
   •  Event history buffer (last 1000 events in memory)

   Documentation Deliverable:
   •  docs/observability/EVENT_REFERENCE.md - All event types with examples
